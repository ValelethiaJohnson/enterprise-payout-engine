# Application Configuration
NODE_ENV=production
PORT=4000
API_VERSION=v1

# Database Configuration (PostgreSQL with Connection Pooling)
DATABASE_URL="postgresql://username:password@localhost:5432/enterprise_payout_db?schema=public&connection_limit=20"

# Redis Concurrency & Distributed Lock Configuration
REDIS_URL="redis://default:secure_password@localhost:6379"

# Payout Provider & Banking API Integration
STRIPE_SECRET_KEY="sk_live_sample_key_here"
STRIPE_WEBHOOK_SECRET="whsec_sample_webhook_secret_here"

# Security & Idempotency Header Configuration
IDEMPOTENCY_HEADER_KEY="X-Idempotency-Key"
HMAC_SIGNATURE_SECRET="your_secure_hmac_secret_key"
